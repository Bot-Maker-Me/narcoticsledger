# Copy to `.env` and fill in. Every value here is public and ships to the browser,
# so only ever put the anon/publishable key in it — never a service-role key.

# Supabase project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (publishable) key. Safe to expose; access is controlled by RLS.
VITE_SUPABASE_ANON_KEY=
